{
  "name": "@polymer/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:up": "tsx src/database/migrate.ts up",
    "migrate:down": "tsx src/database/migrate.ts down",
    "migrate:reset": "tsx src/database/migrate.ts reset"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
