{
  "name": "polymer",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "start": "pnpm --filter @polymer/server start",
    "demo": "turbo run build && node scripts/demo.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "e2e:fleet": "pnpm --filter @polymer/server build && node apps/server/src/e2e/fleet.mjs",
    "e2e:web": "pnpm --filter @polymer/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
